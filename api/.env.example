# Interface to bind; empty means all. Production: 127.0.0.1
HOST=
PORT=8080
DATABASE_URL=postgres://tracker:tracker@localhost:5432/tracker?sslmode=disable
# Long random string; rotating it resets visitor hashes.
HASH_SECRET=change-me
# Bearer token for the stats API; the dashboard sends it. At least 16 chars.
API_TOKEN=change-me-to-a-long-random-string
# Optional: require "Authorization: Bearer <key>" for server-side events (no Origin header).
SERVER_KEY=
# Set true only behind a proxy you control (Fly, Railway, nginx...).
TRUST_PROXY=false
# Development only: accept browser events from localhost for every site.
ALLOW_LOCALHOST=false
BATCH_SIZE=500
FLUSH_INTERVAL=2s
LOG_LEVEL=info
