{
  "name": "@monitoring-tools/tracker",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --minify --format=iife --target=es2017 --outfile=../api/static/t.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "size": "npm run build && gzip -c ../api/static/t.js | wc -c"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
